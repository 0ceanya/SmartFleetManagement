    "SmartFM.Api.OrdersController" [label="OrdersController", fillcolor=white, tooltip="SmartFM.Api.Controllers.OrdersController"];
    "SmartFM.Api.ReportsController" [label="ReportsController", fillcolor=white, tooltip="SmartFM.Api.Controllers.ReportsController"];
    "SmartFM.Api.TrackingController" [label="TrackingController", fillcolor=white, tooltip="SmartFM.Api.Controllers.TrackingController"];
    "SmartFM.Api.ApiExceptionHandler" [label="ApiExceptionHandler", fillcolor=white, tooltip="SmartFM.Api.ErrorHandling.ApiExceptionHandler"];
  }

  subgraph "cluster_SmartFM.Application" {
    label="SmartFM.Application";
    style="filled";
    color="lightgray";

    "SmartFM.Application.BillingCoordinator" [label="BillingCoordinator", fillcolor=white, tooltip="SmartFM.Application.Coordinators.BillingCoordinator"];
    "SmartFM.Application.FleetAssignmentCoordinator" [label="FleetAssignmentCoordinator", fillcolor=white, tooltip="SmartFM.Application.Coordinators.FleetAssignmentCoordinator"];
    "SmartFM.Application.OrderFulfilmentCoordinator" [label="OrderFulfilmentCoordinator", fillcolor=white, tooltip="SmartFM.Application.Coordinators.OrderFulfilmentCoordinator"];
    "SmartFM.Application.RecordCoordinator" [label="RecordCoordinator", fillcolor=white, tooltip="SmartFM.Application.Coordinators.RecordCoordinator"];
    "SmartFM.Application.ReportingCoordinator" [label="ReportingCoordinator", fillcolor=white, tooltip="SmartFM.Application.Coordinators.ReportingCoordinator"];
    "SmartFM.Application.SmartFMSystem" [label="SmartFMSystem", fillcolor=white, tooltip="SmartFM.Application.SmartFMSystem"];
  }

  subgraph "cluster_SmartFM.Domain" {
