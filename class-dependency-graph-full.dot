digraph CSharpDependencies {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, splines=ortho, overlap=false, nodesep=0.2, ranksep=0.8];
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  subgraph "cluster_SmartFM.Api" {
    label="SmartFM.Api";
    style="filled";
    color="lightgray";

    "SmartFM.Api.AuditController" [label="AuditController", fillcolor=white, tooltip="SmartFM.Api.Controllers.AuditController"];
    "SmartFM.Api.BillingController" [label="BillingController", fillcolor=white, tooltip="SmartFM.Api.Controllers.BillingController"];
    "SmartFM.Api.CustomersController" [label="CustomersController", fillcolor=white, tooltip="SmartFM.Api.Controllers.CustomersController"];
    "SmartFM.Api.FleetController" [label="FleetController", fillcolor=white, tooltip="SmartFM.Api.Controllers.FleetController"];
