digraph CSharpDependencies {
  graph [rankdir=LR, fontname="Helvetica", fontsize=14, splines=sprite, overlap=false, nodesep=0.2, ranksep=0.8];
  node [shape=box, style=filled, fillcolor=lightblue, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  "SmartFM.Api" [label="SmartFM.Api\n()"];
  "SmartFM.Application" [label="SmartFM.Application\n()"];
  "SmartFM.Domain" [label="SmartFM.Domain\n()"];
  "SmartFM.Infrastructure" [label="SmartFM.Infrastructure\n()"];

  // Project reference edges
  "SmartFM.Api" -> "SmartFM.Application" [penwidth=1.0];
  "SmartFM.Api" -> "SmartFM.Infrastructure" [penwidth=1.0];
  "SmartFM.Application" -> "SmartFM.Domain" [penwidth=1.0];
  "SmartFM.Infrastructure" -> "SmartFM.Domain" [penwidth=1.0];
  "SmartFM.Infrastructure" -> "SmartFM.Application" [penwidth=1.0];
}
